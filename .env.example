# ==============================================================================
# JASTIP WAR — Environment Configuration
# Copy this file to .env.local and provide your Supabase credentials.
# Note: When Supabase credentials are omitted in local development, JASTIP WAR
# automatically activates its persistent local transactional database engine
# (.data/jastip-store.json) seeded with realistic garage sale products & sessions
# while still executing atomic mutex-locked inventory reservations.
# ==============================================================================

# Public Supabase Config
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Supabase Service Role Key (NEVER expose to NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Bootstrap Credentials (for local / hybrid admin authentication)
ADMIN_DEFAULT_EMAIL=admin@jastipwar.id
ADMIN_DEFAULT_PASSWORD=JastipWarAdmin2026!
ADMIN_SESSION_SECRET=jastip-war-production-hmac-secret-change-me

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

